        {
          "name": "03 - POST /login com senha correta (200 + token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"senha\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const corpo = pm.response.json();",
                  "pm.test('Retornou o token', function () {",
                  "    pm.expect(corpo.access_token).to.be.a('string');",
                  "});",
                  "// Guarda o token para as próximas requisições",
                  "pm.collectionVariables.set('token', corpo.access_token);"
                ]
              }
            }
          ]
        },
